{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "lib": ["ES2019"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": false,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "aux/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test"
  ]
}
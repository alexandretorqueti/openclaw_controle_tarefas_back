// This is your Prisma schema file,

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(uuid())
  name            String
  nickname        String        @unique
  email           String?       @unique
  avatarUrl       String?
  role            String        @default("Viewer")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  attachments     Attachment[]
  comments        Comment[]
  createdProjects Project[]     @relation("ProjectCreator")
  taskHistory     TaskHistory[]
  assignedTasks   Task[]        @relation("TaskAssignee")
  createdTasks    Task[]        @relation("TaskCreator")
  logs            Log[]
  taskExecutionLogs TaskExecutionLog[]

  @@map("users")
}

model ProjectType {
  id            String   @id @default(uuid())
  name          String
  personaPrompt String
  baseRules     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  projects      Project[]

  @@map("project_types")
}

model Project {
  id             String   @id @default(uuid())
  name           String
  description    String
  regras         String?
  status         Boolean  @default(true)
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String
  createdBy      User     @relation("ProjectCreator", fields: [createdById], references: [id])
  projectTypeId  String?
  projectType    ProjectType? @relation(fields: [projectTypeId], references: [id])
  tasks          Task[]
  
  // Novos campos para configuração de repositórios
  frontendPath   String?  // Caminho absoluto do repositório frontend
  frontendPort   Int?     // Porta do frontend (ex: 3000, 8080)
  backendPath    String?  // Caminho absoluto do repositório backend
  backendPort    Int?     // Porta do backend (ex: 3001, 8081)
  repositoryUrl  String?  // URL do repositório principal (GitHub, GitLab, etc.)
  pastaBase      String?  // Campo pasta base (não obrigatório)
  agent          String?  // Agente padrão para tarefas do projeto
  modeloAuxiliar String?
  frontendBuildCmd String?
  backendBuildCmd  String?
  @@map("projects")
}

model Status {
  id           String  @id @default(uuid())
  name         String
  colorCode    String  @default("#666666")
  isFinalState Boolean @default(false)
  visibleToAi Boolean @default(true) @map("visible_to_ai")
  order        Int     @default(0)
  tasks        Task[]

  @@map("statuses")
}

model Priority {
  id     String @id @default(uuid())
  name   String
  weight Int    @default(1)
  tasks  Task[]

  @@map("priorities")
}

model Task {
  id              String        @id @default(uuid())
  title           String
  description     String
  isCompleted     Boolean       @default(false)
  deadline        DateTime
  position        Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  isRecurring     Boolean       @default(false)
  recurrenceType  String?
  recurrenceTimes String?
  recurrenceDays  String?
  lastExecutedAt  DateTime?
  nextExecutionAt DateTime?
  agent           String?
  projectId       String
  parentTaskId    String?
  statusId        String
  priorityId      String
  createdById     String
  assignedToId    String
  attachments     Attachment[]
  comments        Comment[]
  dependents      Dependency[]  @relation("TaskDependents")
  dependencies    Dependency[]  @relation("TaskDependencies")
  history         TaskHistory[]
  assignedTo      User          @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy       User          @relation("TaskCreator", fields: [createdById], references: [id])
  priority        Priority      @relation(fields: [priorityId], references: [id])
  status          Status        @relation(fields: [statusId], references: [id])
  parentTask      Task?         @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  subtasks        Task[]        @relation("TaskHierarchy")
  project         Project       @relation(fields: [projectId], references: [id])
  executionLogs   TaskExecutionLog[]

  @@map("tasks")
}

model Dependency {
  id              String @id @default(uuid())
  type            String @default("BLOCKING")
  taskId          String
  dependentTaskId String
  dependentTask   Task   @relation("TaskDependents", fields: [dependentTaskId], references: [id])
  task            Task   @relation("TaskDependencies", fields: [taskId], references: [id])

  @@unique([taskId, dependentTaskId])
  @@map("dependencies")
}

model Comment {
  id              String    @id @default(uuid())
  content         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  taskId          String
  userId          String
  parentCommentId String?
  parentComment   Comment?  @relation("CommentHierarchy", fields: [parentCommentId], references: [id])
  replies         Comment[] @relation("CommentHierarchy")
  user            User      @relation(fields: [userId], references: [id])
  task            Task      @relation(fields: [taskId], references: [id])

  @@map("comments")
}

model Attachment {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  mimeType  String
  createdAt DateTime @default(now())
  taskId    String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id])

  @@map("attachments")
}

model TaskHistory {
  id          String   @id @default(uuid())
  oldStatusId String
  newStatusId String
  notes       String?
  timestamp   DateTime @default(now())
  taskId      String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  task        Task     @relation(fields: [taskId], references: [id])

  @@map("task_history")
}

model Log {
  id             String   @id @default(uuid())
  timestamp      DateTime @default(now())
  level          String   // ERROR, WARN, INFO, DEBUG
  endpoint       String?
  method         String?
  statusCode     Int?
  message        String?
  errorType      String?
  stackTrace     String?
  requestBody    String?
  requestQuery   String?
  requestParams  String?
  headers        String?
  clientIp       String?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  correlationId  String?
  parentLogId    String?
  parentLog      Log?     @relation("LogHierarchy", fields: [parentLogId], references: [id])
  childLogs      Log[]    @relation("LogHierarchy")
  responseTime   Int?     // milliseconds

  @@map("logs")
}


model TaskExecutionLog {
  id              String   @id @default(uuid())
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  model           String
  executionNotes  String?
  success         Boolean  @default(false)
  durationMs      Int?
  exitCode        Int?
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([taskId])
  @@index([startedAt])
  @@index([userId])
  @@map("task_execution_logs")
}

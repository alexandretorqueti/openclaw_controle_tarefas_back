generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  name              String
  nickname          String             @unique
  email             String?            @unique
  avatarUrl         String?
  role              String             @default("Viewer")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attachments       Attachment[]
  comments          Comment[]
  logs              Log[]
  createdProjects   Project[]          @relation("ProjectCreator")
  taskExecutionLogs TaskExecutionLog[]
  taskHistory       TaskHistory[]
  createdTasks      Task[]             @relation("TaskCreator")
  assignedTasks     Task[]             @relation("TaskAssignee")

  @@map("users")
}

model ProjectType {
  id            String    @id @default(uuid())
  name          String
  personaPrompt String
  baseRules     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[]

  @@map("project_types")
}

model Project {
  id               String       @id @default(uuid())
  name             String
  description      String
  regras           String?
  status           Boolean      @default(true)
  ativo            Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdById      String
  projectTypeId    String?
  frontendPath     String?
  frontendPort     Int?
  backendPath      String?
  backendPort      Int?
  repositoryUrl    String?
  pastaBase        String?
  agent            String?
  programadorFront    String?
  programadorBack     String?
  frontendBuildCmd String?
  backendBuildCmd  String?
  modeloAuxiliar   String?
  projectType      ProjectType? @relation(fields: [projectTypeId], references: [id])
  createdBy        User         @relation("ProjectCreator", fields: [createdById], references: [id])
  tasks            Task[]

  @@map("projects")
}

model Status {
  id           String  @id @default(uuid())
  name         String
  colorCode    String  @default("#666666")
  isFinalState Boolean @default(false)
  visibleToAi  Boolean @default(true) @map("visible_to_ai")
  order        Int     @default(0)
  tasks        Task[]

  @@map("statuses")
}

model Priority {
  id     String @id @default(uuid())
  name   String
  weight Int    @default(1)
  tasks  Task[]

  @@map("priorities")
}

model Task {
  id              String             @id @default(uuid())
  title           String
  description     String
  isCompleted     Boolean            @default(false)
  deadline        DateTime
  position        Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  isRecurring     Boolean            @default(false)
  recurrenceType  String?
  recurrenceTimes String?
  recurrenceDays  String?
  lastExecutedAt  DateTime?
  nextExecutionAt DateTime?
  agent           String?
  domain          String?
  isDecomposed    Boolean            @default(false)
  isAtomic        Boolean            @default(false)
  projectId       String
  parentTaskId    String?
  statusId        String
  priorityId      String
  createdById     String
  assignedToId          String
  arquitetosPromptContent String?
  arquitetosAnalysisContent String?
  arquitetosTerminalContent String?
  programadorTerminalContent String?
  programadorReportContent String?
  attachments             Attachment[]
  comments        Comment[]
  dependencies    Dependency[]       @relation("TaskDependencies")
  dependents      Dependency[]       @relation("TaskDependents")
  executionLogs   TaskExecutionLog[]
  history         TaskHistory[]
  project         Project            @relation(fields: [projectId], references: [id])
  parentTask      Task?              @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  subtasks        Task[]             @relation("TaskHierarchy")
  status          Status             @relation(fields: [statusId], references: [id])
  priority        Priority           @relation(fields: [priorityId], references: [id])
  createdBy       User               @relation("TaskCreator", fields: [createdById], references: [id])
  assignedTo      User               @relation("TaskAssignee", fields: [assignedToId], references: [id])

  @@map("tasks")
}

model Dependency {
  id              String @id @default(uuid())
  type            String @default("BLOCKING")
  taskId          String
  dependentTaskId String
  task            Task   @relation("TaskDependencies", fields: [taskId], references: [id])
  dependentTask   Task   @relation("TaskDependents", fields: [dependentTaskId], references: [id])

  @@unique([taskId, dependentTaskId])
  @@map("dependencies")
}

model Comment {
  id              String    @id @default(uuid())
  content         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  taskId          String
  userId          String
  parentCommentId String?
  task            Task      @relation(fields: [taskId], references: [id])
  user            User      @relation(fields: [userId], references: [id])
  parentComment   Comment?  @relation("CommentHierarchy", fields: [parentCommentId], references: [id])
  replies         Comment[] @relation("CommentHierarchy")

  @@map("comments")
}

model Attachment {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  mimeType  String
  createdAt DateTime @default(now())
  taskId    String
  userId    String
  task      Task     @relation(fields: [taskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("attachments")
}

model TaskHistory {
  id          String   @id @default(uuid())
  oldStatusId String
  newStatusId String
  notes       String?
  timestamp   DateTime @default(now())
  taskId      String
  userId      String
  task        Task     @relation(fields: [taskId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@map("task_history")
}

model Log {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  level         String
  endpoint      String?
  method        String?
  statusCode    Int?
  message       String?
  errorType     String?
  stackTrace    String?
  requestBody   String?
  requestQuery  String?
  requestParams String?
  headers       String?
  clientIp      String?
  userId        String?
  correlationId String?
  parentLogId   String?
  responseTime  Int?
  parentLog     Log?     @relation("LogHierarchy", fields: [parentLogId], references: [id])
  childLogs     Log[]    @relation("LogHierarchy")
  user          User?    @relation(fields: [userId], references: [id])

  @@map("logs")
}

model TaskExecutionLog {
  id             String    @id @default(uuid())
  taskId         String
  userId         String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  model          String
  executionNotes String?
  success        Boolean   @default(false)
  durationMs     Int?
  exitCode       Int?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User?     @relation(fields: [userId], references: [id])
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([startedAt])
  @@index([userId])
  @@map("task_execution_logs")
}

model AgentAvatar {
  id        String   @id @default(cuid())
  agentId   String   @unique
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  path      String   // Caminho relativo no sistema de arquivos
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agent_avatars")
  @@index([agentId])
}

model Agent {
  id        String   @id @default(uuid())
  name      String
  role      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  avatar    AgentAvatar?

  @@map("agents")
}

model Stage {
  id        Int      @id @default(autoincrement())
  etapa     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stages")
}

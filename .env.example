# Environment Variables for Task Manager Backend
# Copy this file to .env and fill in the values

# Database
DATABASE_URL="file:./dev.db"

# Server
PORT=3001
NODE_ENV="development"

# CORS
CORS_ORIGIN="*"
FRONTEND_URLS="http://localhost:8090,http://192.168.1.70:8090,http://tarefas.local:8090"

# Google OAuth (required for Google login)
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Session
SESSION_SECRET="generate-a-strong-random-secret-here"

# Notes:
# 1. For production, use a strong random string for SESSION_SECRET
# 2. Update GOOGLE_CALLBACK_URL for production deployment
# 3. Set NODE_ENV="production" in production
# 4. Use a proper database (PostgreSQL/MySQL) in production instead of SQLite
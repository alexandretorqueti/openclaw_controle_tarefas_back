{
  "name": "task-manager-backend",
  "version": "1.0.0",
  "description": "Backend API para Sistema de Gestão de Tarefas",
  "main": "src/server.js",
  "scripts": {
    "start": "ts-node src/monitor.ts",
    "dev": "ts-node-dev --respawn src/monitor.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "test": "jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:setup": "NODE_ENV=test node scripts/test-seed.js",
    "test:clean": "rm -f prisma/test.db",
    "build": "tsc",
    "test:coverage": "NODE_ENV=test jest --coverage"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.13.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "proper-lockfile": "^4.1.2",
    "tslib": "^2.8.1",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.0.0",
    "@types/node": "^18.19.130",
    "jest": "^29.0.0",
    "nodemon": "^3.0.1",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-migrate": "^0.1.35",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
